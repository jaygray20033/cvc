# CVC web environment (Vite dev only). Copy to .env. Never commit .env.
# Production does NOT use these: runtime config comes from public/config.js
# generated at container start (see apps/web/Dockerfile, P1.11).

# Dev: Vite proxies /api, /socket.io, /docs, /health to the api container,
# so leave these empty to use same-origin. Set absolute URLs only to bypass the proxy.
VITE_API_URL=
VITE_WS_URL=