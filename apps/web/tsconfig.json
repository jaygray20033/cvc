{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "baseUrl": "./",
    "paths": {
      "@cvc/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["src"]
}