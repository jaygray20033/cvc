// CVC Prisma schema. The full data model lands in later phases (P2+); see docs/erd.md.
// Naming: tables plural snake_case via @@map; columns camelCase in code via @map.
// Money: Decimal + a currency column (VND/CNY). Never float. Migrations additive only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Foundational idempotency table (CLAUDE.md: every money API takes an Idempotency-Key).
// Replaying the same key must not create a second transaction. expiresAt
// powers the 24h TTL (P2.21): expired rows are skipped and deletable.
model IdempotencyKey {
  key         String   @id @db.VarChar(191)
  scope       String   @db.VarChar(100)
  requestHash String   @db.VarChar(64)
  response    Json?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Auth domain (P2.1–P2.4). Roles/KYC/organizations land in P2.7+ / P3.1.
// Secrets are never stored in plaintext: passwords are argon2id hashes, email
// verification / password-reset tokens and OTP codes are stored as SHA-256
// hashes, refresh tokens are stored hashed inside Session.
// ---------------------------------------------------------------------------

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model User {
  id              String     @id @default(cuid())
  // Nullable email + phone-only signup lands with P4 (phone unique below is
  // already reserved); every current flow requires email, so the column stays
  // required until then.
  email           String     @unique @db.VarChar(191)
  emailVerifiedAt DateTime?
  phone           String?    @unique @db.VarChar(20)
  passwordHash    String?    @db.VarChar(255)
  status          UserStatus @default(PENDING_VERIFICATION)
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions           Session[]
  verificationTokens VerificationToken[]
  recoveryCodes      RecoveryCode[]
  userRoles          UserRole[]
  // TOTP 2FA (P2.5, P3.1): secret lives in its own table (AES-256-GCM).
  totpSecret         TotpSecret?

  // Profile domain (P2.11) + KYC (P2.12/P2.13).
  profile        Profile?
  addresses      Address[]
  bankAccounts   BankAccount[]
  kycSubmissions KycSubmission[]

  // Notification engine (P2.18).
  notifications          Notification[]
  notificationPreference NotificationPreference?

  // Catalog/sourcing (P3.2/P3.3): supplier account links, RFQs, orders.
  supplierAccounts         SupplierAccount?
  sourcingRequests         SourcingRequest[]
  sourcingRequestsAssigned SourcingRequest[]           @relation("SourcingRequestAssignee")
  sourcingRequestNotes     SourcingRequestNote[]       @relation("SourcingRequestNoteAuthor")
  sourcingInvitations      SourcingRequestInvitation[] @relation("SourcingRequestInviter")
  orders                   Order[]
  organizationsOwned       Organization[]
  quoteSelectionsDecided   QuoteSelection[]
  claimsFiled              Claim[]
  claimProposals           ClaimProposal[]
  claimResolutions         ClaimResolution[]
  shipmentStopsEntered     ShipmentStop[]

  // Deal room / contracts (P3.4/P3.5).
  dealRoomMemberships           DealRoomMember[]
  dealMessagesSent              Message[]
  offersMade                    Offer[]
  lockedTermsConfirmed          LockedTerms[]
  contractSignatures            ContractSignature[]
  // Group buy (P3.6).
  campaignsCreated              Campaign[]
  campaignStageLogs             CampaignStageLog[]
  surveysCreated                CampaignSurvey[]
  risksRecorded                 CampaignRisk[]
  participations                Participation[]
  goodsRequestsHandled          GoodsRequest[]
  returnRequestsDecided         ReturnRequest[]
  // Resale (P3.7).
  storesOwned                   Store[]
  retailerRegistration          RetailerRegistration?  @relation("RetailerOwner")
  retailerRegistrationsReviewed RetailerRegistration[] @relation("RetailerReviewer")
  allocationsMade               Allocation[]
  transfersSent                 Transfer[]             @relation("TransferSender")
  transfersReceived             Transfer[]             @relation("TransferReceiver")
  receiptsUploaded              TransferReceipt[]
  // Sales/inventory (P3.8).
  salesMade                     Sale[]
  saleImportsUploaded           SaleImport[]
  inventoryMovementsMade        InventoryMovement[]
  stockCountsDone               StockCount[]
  inspectionsDone               Inspection[]
  qcReportsDone                 QcReport[]
  ContractParty                 ContractParty[]

  // Money (P3.9).
  wallet                       Wallet?
  ledgerTransactionsCreated    LedgerTransaction[]
  paymentsMade                 Payment[]             @relation("PaymentPayer")
  paymentsConfirmed            Payment[]             @relation("PaymentConfirmer")
  paymentProofsUploaded        PaymentProof[]
  payoutsApproved              Payout[]              @relation("PayoutApprover")
  payoutProofsUploaded         PayoutProof[]
  bankStatementImportsUploaded BankStatementImport[]
  reconciliationRunsRun        ReconciliationRun[]
  reconciliationItemsResolved  ReconciliationItem[]  @relation("ReconResolver")
  // Misc (P3.10).
  fundingApplications          FundingApplication[]
  fundingApplicationsReviewed  FundingApplication[]  @relation("FundingReviewer")
  crmActivitiesBy              CrmActivity[]
  showroomVisitsBy             ShowroomVisit[]
  reportsGenerated             Report[]
  crmContactsOwned             CrmContact[]
  publishedSourcingCases       SourcingCase[]        @relation("SourcingCasePublisher")

  @@map("users")
}

// Platform roles per user (P2.9). Source of truth for RBAC — replaces the
// roles Json stopgap column on User. Admin permission groups (P2.10:
// admin_super/admin_finance/admin_ops/admin_support) are stored here too as
// `admin_*` rows; only users holding `admin` should have them.
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @db.VarChar(32)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, role])
  @@index([role])
  @@map("user_roles")
}

// One-time backup codes for TOTP login (P2.5). Only SHA-256 hashes stored,
// each code can be used exactly once.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique @db.VarChar(64)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("recovery_codes")
}

// One-time tokens for email verification and password reset.
// Token itself is random 32 bytes hex, only the SHA-256 hash is stored.
model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@map("verification_tokens")
}

// Login sessions. refreshHash holds the SHA-256 of the *current* refresh
// token; familyId groups a rotation chain so reuse of an old token revokes
// the whole chain (P2.4).
model Session {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId    String    @db.VarChar(64)
  refreshHash String    @unique @db.VarChar(64)
  // Role currently in use for this session (P2.9). Switching roles re-issues
  // the access token without a new login and is audit-logged.
  activeRole  String    @default("buyer") @db.VarChar(32)
  expiresAt   DateTime
  lastUsedAt  DateTime  @default(now())
  revokedAt   DateTime?
  ip          String?   @db.VarChar(64)
  userAgent   String?   @db.VarChar(512)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, familyId])
  @@index([userId, revokedAt])
  @@map("sessions")
}

// Email OTP codes for password-free login (P2.2, delivered via Gmail/SMTP —
// no SMS per the cost decision). Only the SHA-256 hash of the code is stored
// and the code never appears in logs.
model OtpRequest {
  id         String    @id @default(cuid())
  email      String    @db.VarChar(191)
  codeHash   String    @db.VarChar(64)
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  ip         String?   @db.VarChar(64)
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@map("otp_requests")
}

// ---------------------------------------------------------------------------
// Profile + KYC domain (P2.11–P2.13). Bank account numbers are AES-256-GCM
// encrypted at rest (accountNoEnc) with a masked display value (accountNoLast4)
// and a SHA-256 hash (accountNoHash) for uniqueness. KYC files live in the
// private S3 bucket; only the owner and admin KYC can download them (short
// lived presigned URLs, access logged via KycEvent).
// ---------------------------------------------------------------------------

// Business type of the profile (P2.11).
enum OrgType {
  PERSONAL
  BUSINESS_HOUSEHOLD
  COMPANY
}

// KYC document types (P2.12). CCCD = citizen id card.
// PORTRAIT = selfie holding the CCCD (P2.14, required for manual identity match).
enum KycDocType {
  CCCD_FRONT
  CCCD_BACK
  PORTRAIT
  BUSINESS_REG
  AUTHORIZATION
}

// Lifecycle of one review round (P2.13).
enum KycStatus {
  PENDING
  NEED_MORE
  APPROVED
  REJECTED
}

// Upload is two-phase: presigned PUT (UPLOADING) then client confirm (READY).
enum UploadStatus {
  UPLOADING
  READY
}

// Who did what on a submission — the review history (P2.13).
enum KycEventType {
  SUBMITTED
  DOCUMENT_UPLOADED
  APPROVED
  NEED_MORE
  REJECTED
  DOCUMENT_ACCESSED
  // P2.14: a duplicate image/CCCD was detected across accounts, and each time
  // an admin reveals the raw CCCD number.
  DUPLICATE_FLAGGED
  CCCD_ACCESSED
}

model Profile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgType            OrgType  @default(PERSONAL)
  // Person display name; for COMPANY this is the company name.
  displayName        String   @db.VarChar(191)
  // MST (tax id) — validated, unique when present.
  taxId              String?  @db.VarChar(14)
  // Business registration number (hộ kinh doanh/doanh nghiệp).
  businessRegNo      String?  @db.VarChar(20)
  representativeName String?  @db.VarChar(191)
  address            String?  @db.VarChar(255)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("profiles")
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String?  @db.VarChar(50)
  receiverName String   @db.VarChar(191)
  phone        String   @db.VarChar(20)
  city         String   @db.VarChar(100)
  district     String   @db.VarChar(100)
  ward         String   @db.VarChar(100)
  line         String   @db.VarChar(255)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

model BankAccount {
  id             String        @id @default(cuid())
  // Owned by a user (default) or an organization (P3.1); at least one must be
  // set — enforced in the service layer (MySQL disallows a CHECK constraint
  // on FK columns that carry referential actions like CASCADE/SET NULL).
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bankName       String        @db.VarChar(100)
  holderName     String        @db.VarChar(191)
  // AES-256-GCM encrypted account number; never selected into API responses.
  accountNoEnc   String        @db.VarChar(255)
  // Display-only: last 4 digits, e.g. "1234" -> "****1234".
  accountNoLast4 String        @db.VarChar(4)
  // SHA-256 of the number: uniqueness check without decryption.
  accountNoHash  String        @unique @db.VarChar(64)
  isDefault      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  refunds     Refund[]
  payouts     Payout[]
  withdrawals Withdrawal[]

  @@index([userId])
  @@index([organizationId])
  @@map("bank_accounts")
}

model KycSubmission {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          KycStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  // Required reason for reject/need_more; also the user-visible note.
  reviewNote      String?   @db.VarChar(500)
  // P2.14 manual identity match. CCCD number is AES-256-GCM encrypted for admin
  // viewing (cccdNumberEnc); cccdHash is a salted HMAC-SHA256 used only to
  // detect the same number reused across accounts (never the number itself).
  cccdNumberEnc   String?   @db.VarChar(255)
  cccdHash        String?   @db.VarChar(64)
  // Set when a duplicate image or CCCD number links this account to another.
  duplicateFlag   Boolean   @default(false)
  // Admin's eye-match checklist recorded on approve (5 booleans), see kyc.dto.
  reviewChecklist Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  documents KycDocument[]
  events    KycEvent[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([cccdHash])
  @@map("kyc_submissions")
}

model KycDocument {
  id           String        @id @default(cuid())
  submissionId String
  submission   KycSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  type         KycDocType
  mime         String        @db.VarChar(100)
  sizeBytes    Int
  // Private bucket object key, e.g. kyc/{userId}/{docId}. No PII in the key.
  s3Key        String        @db.VarChar(255)
  bucket       String        @db.VarChar(100)
  uploadStatus UploadStatus  @default(UPLOADING)
  // P2.14: SHA-256 of the stored bytes, computed on confirm. Same hash across
  // different accounts => the same photo was reused (duplicate warning).
  imageHash    String?       @db.VarChar(64)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([submissionId])
  @@index([imageHash])
  @@map("kyc_documents")
}

// Append-only review history + access log (P2.12 download logging, P2.13).
model KycEvent {
  id           String        @id @default(cuid())
  submissionId String
  submission   KycSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  type         KycEventType
  actorId      String?       @db.VarChar(64)
  actorRole    String?       @db.VarChar(32)
  note         String?       @db.VarChar(500)
  createdAt    DateTime      @default(now())

  @@index([submissionId, createdAt])
  @@map("kyc_events")
}

// ---------------------------------------------------------------------------
// Shared services (P2.16–P2.18). AuditLog is append-only: no update/delete
// API anywhere, integrity guarded by a per-row hash chain. FileObject uses
// ownerType/ownerId (loose reference, no FK) so the same table serves every
// future owner kind (order, campaign, deal room...). Notifications are
// in-app rows; email delivery is decided by NotificationPreference unless
// the event is mandatory (security/money).
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @db.VarChar(64)
  actorRole  String?  @db.VarChar(32)
  action     String   @db.VarChar(100)
  entityType String?  @db.VarChar(64)
  entityId   String?  @db.VarChar(64)
  before     Json?
  after      Json?
  ip         String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(512)
  requestId  String?  @db.VarChar(64)
  // Hash chain (tamper detection): hash = sha256(prevHash + row payload).
  prevHash   String   @db.VarChar(64)
  hash       String   @unique @db.VarChar(64)
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

enum FileStatus {
  UPLOADING
  READY
  REJECTED
}

enum ScanStatus {
  NOT_SCANNED
  PENDING
  CLEAN
  INFECTED
  ERROR
}

model FileObject {
  id           String     @id @default(cuid())
  ownerType    String     @db.VarChar(32)
  ownerId      String     @db.VarChar(64)
  bucket       String     @db.VarChar(100)
  s3Key        String     @db.VarChar(255)
  purpose      String?    @db.VarChar(64)
  declaredMime String     @db.VarChar(100)
  // Real MIME from magic bytes; mismatch with declaredMime -> rejected.
  detectedMime String?    @db.VarChar(100)
  sizeBytes    Int
  status       FileStatus @default(UPLOADING)
  // Download requires READY + CLEAN; PENDING blocks download (P2.17 DoD).
  scanStatus   ScanStatus @default(NOT_SCANNED)
  scanAt       DateTime?
  thumbnailKey String?    @db.VarChar(255)
  sha256       String?    @db.VarChar(64)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // P3.2/P3.3 loose owners keep a hard FK where the reference is first-class.
  productImages              ProductImage[]
  partnerBanners             PartnerBanner[]
  sourcingRequestAttachments SourcingRequestAttachment[]
  shipments                  Shipment[]
  returnShipments            ReturnShipment[]
  // P3.4-P3.8 file references.
  messageAttachments         MessageAttachment[]
  signedContracts            Contract[]
  transferReceipts           TransferReceipt[]
  inspectionPhotos           InspectionPhoto[]
  // P3.9 file references.
  paymentProofs              PaymentProof[]
  payoutProofs               PayoutProof[]
  invoices                   Invoice[]

  @@index([ownerType, ownerId, createdAt])
  @@index([sha256])
  @@map("files")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     String    @db.VarChar(64)
  title     String    @db.VarChar(200)
  body      String    @db.VarChar(500)
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Channel opt-outs; mandatory events (security/money) ignore these.
  email     Boolean  @default(true)
  inApp     Boolean  @default(true)
  sms       Boolean  @default(false)
  zns       Boolean  @default(false)
  push      Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

// ---------------------------------------------------------------------------
// Shared services phase 2.5 (P2.19–P2.23). IdempotencyKey (founded earlier)
// gains an expiry column; SystemSetting is runtime config (versioned, audit
// logged, cached). SearchDocument is the generic FULLTEXT index that domain
// modules feed with searchable text; the real product tables land in P3.2.
// ---------------------------------------------------------------------------

model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  version     Int      @default(1)
  updatedById String?  @db.VarChar(64)
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model SearchDocument {
  id         String   @id @default(cuid())
  entityType String   @db.VarChar(32)
  entityId   String   @db.VarChar(64)
  title      String   @db.VarChar(200)
  // Diacritics-stripped lowercase text ("Áo mưa" -> "ao mua"); FULLTEXT
  // ngram index is added by raw SQL in the migration (Prisma cannot declare
  // a custom parser).
  searchText String   @db.VarChar(500)
  data       Json?
  status     String   @default("published") @db.VarChar(16)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType, status])
  @@map("search_documents")
}

// ---------------------------------------------------------------------------
// P3.1 — Organizations & TOTP
// ---------------------------------------------------------------------------

// Organization lifecycle (P3.1).
enum OrgStatus {
  ACTIVE
  DISABLED
}

model Organization {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(191)
  taxId     String?   @db.VarChar(32)
  contact   String?   @db.VarChar(191)
  phone     String?   @db.VarChar(20)
  status    OrgStatus @default(ACTIVE)
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  deletedAt DateTime? // soft delete: org data is referenced by orders
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bankAccounts BankAccount[]

  @@index([ownerId])
  @@index([status])
  @@map("organizations")
}

// TOTP 2FA secret (P3.1): split from users so the encrypted secret is never
// accidentally selected with the user row.
model TotpSecret {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // AES-256-GCM encrypted base32 secret (ENCRYPTION_KEY).
  secretEnc String    @db.VarChar(255)
  enabledAt DateTime? // null = setup in progress, not yet confirmed
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("totp_secrets")
}

// ---------------------------------------------------------------------------
// P3.2 — Catalog & suppliers
// ---------------------------------------------------------------------------

model Category {
  id        String     @id @default(cuid())
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  name      String     @db.VarChar(100)
  slug      String     @unique @db.VarChar(120)
  sortIndex Int        @default(0)
  deletedAt DateTime? // soft delete: products reference categories
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  products Product[]

  sourcingRequests SourcingRequest[]

  @@index([parentId])
  @@map("categories")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id           String        @id @default(cuid())
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // Human-facing SKU, format "CVC-001" (P3.2).
  sku          String        @unique @db.VarChar(32)
  name         String        @db.VarChar(200)
  spec         String?       @db.VarChar(500)
  moq          Int           @default(1)
  leadTimeDays Int?
  // Internal reference price; never returned by public APIs (P3.2).
  priceRef     Decimal?      @db.Decimal(18, 2)
  currency     String        @default("VND") @db.VarChar(3)
  status       ProductStatus @default(DRAFT)
  publishedAt  DateTime?
  deletedAt    DateTime? // soft delete: orders reference products
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  images                    ProductImage[]
  specs                     ProductSpec[]
  supplierProducts          SupplierProduct[]
  campaignLines             CampaignLine[]
  participationLines        ParticipationLine[]
  allocationLines           AllocationLine[]
  saleLines                 SaleLine[]
  resaleListings            ResaleListing[]
  inventoryLots             InventoryLot[]
  sourcingCaseSources       SourcingCase[]      @relation("SourcingCaseSource")
  sourcingCaseItems         SourcingCase[]      @relation("SourcingCaseItem")
  sourcingReferenceRequests SourcingRequest[]   @relation("SourcingReferenceProduct")

  @@index([categoryId, status])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id           String      @id @default(cuid())
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileObjectId String?
  fileObject   FileObject? @relation(fields: [fileObjectId], references: [id], onDelete: SetNull)
  alt          String?     @db.VarChar(200)
  sortIndex    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([productId])
  @@map("product_images")
}

model ProductSpec {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String   @db.VarChar(100)
  value     String   @db.VarChar(255)
  sortIndex Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, key])
  @@map("product_specs")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Supplier {
  id            String         @id @default(cuid())
  name          String         @db.VarChar(191)
  province      String?        @db.VarChar(100)
  country       String         @default("CN") @db.VarChar(2)
  contactName   String?        @db.VarChar(100)
  contactPhone  String?        @db.VarChar(32)
  contactWechat String?        @db.VarChar(64)
  address       String?        @db.VarChar(500)
  notes         String?        @db.VarChar(500)
  status        SupplierStatus @default(ACTIVE)
  deletedAt     DateTime? // soft delete: orders/quotes reference suppliers
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  accounts            SupplierAccount[]
  supplierProducts    SupplierProduct[]
  quotes              Quote[]
  orders              Order[]
  campaigns           Campaign[]
  sourcingInvitations SourcingRequestInvitation[]

  @@index([status])
  @@map("suppliers")
}

// Platform user linked to a supplier entity (1-1 per user, P3.2).
enum SupplierAccountStatus {
  ACTIVE
  SUSPENDED
}

model SupplierAccount {
  id         String                @id @default(cuid())
  userId     String                @unique
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  // Free-form role label inside the supplier company.
  title      String?               @db.VarChar(100)
  isPrimary  Boolean               @default(false)
  // P4.5: suspended accounts cannot log in; activated again by admin.
  status     SupplierAccountStatus @default(ACTIVE)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([supplierId])
  @@map("supplier_accounts")
}

// Per-supplier cost price for a catalog product (P3.2); internal only.
model SupplierProduct {
  id           String    @id @default(cuid())
  supplierId   String
  supplier     Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierSku  String?   @db.VarChar(64)
  costPrice    Decimal   @db.Decimal(18, 2)
  currency     String    @default("CNY") @db.VarChar(3)
  moq          Int       @default(1)
  leadTimeDays Int?
  // P4.4/D12: admin approval required before a supplier listing can go public.
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([supplierId, productId])
  @@map("supplier_products")
}

enum BannerPartnerType {
  SUPPLIER
  SHIPPING
}

enum BannerPosition {
  HOME_TOP
  HOME_MID
  CATEGORY_SIDEBAR
  SEARCH_SIDEBAR
}

model PartnerBanner {
  id               String            @id @default(cuid())
  partnerType      BannerPartnerType
  name             String            @db.VarChar(191)
  logoFileObjectId String?
  logoFile         FileObject?       @relation(fields: [logoFileObjectId], references: [id], onDelete: SetNull)
  linkUrl          String?           @db.VarChar(500)
  position         BannerPosition
  isActive         Boolean           @default(true)
  sortIndex        Int               @default(0)
  // Display window; null = always active.
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([position, isActive])
  @@map("partner_banners")
}

// ---------------------------------------------------------------------------
// P3.3 — Sourcing (RFQ -> quotes -> order -> shipment/claims/refunds)
// ---------------------------------------------------------------------------

enum SourcingRequestStatus {
  OPEN
  QUOTED
  SELECTED
  CONVERTED
  EXPIRED
  CLOSED
  CANCELLED
}

// P4.11: standard buyer RFQs vs CVC concierge requests (guest buyer contact,
// CVC matches the supplier and opens the room directly).
enum SourcingRequestWorkflow {
  STANDARD
  CONCIERGE
}

model SourcingRequest {
  id                 String                  @id @default(cuid())
  // Business number, format "CVC-RFQ-..." (P3.3).
  requestNo          String                  @unique @db.VarChar(32)
  buyerId            String
  buyer              User                    @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  title              String                  @db.VarChar(200)
  content            String?                 @db.VarChar(2000)
  quantity           Int?
  // P4.7: target sales market (e.g. "Việt Nam", "EU").
  market             String?                 @db.VarChar(100)
  // Buyer target price for negotiation.
  targetPrice        Decimal?                @db.Decimal(18, 2)
  currency           String                  @default("VND") @db.VarChar(3)
  expiresAt          DateTime?
  status             SourcingRequestStatus   @default(OPEN)
  // P4.9: category lets matching suppliers see the RFQ without an invite.
  categoryId         String?
  category           Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // P4.11: concierge requests store walk-in contact info and a catalogue
  // reference product used to match the supplier.
  workflow           SourcingRequestWorkflow @default(STANDARD)
  contactName        String?                 @db.VarChar(100)
  contactPhone       String?                 @db.VarChar(20)
  referenceProductId String?
  referenceProduct   Product?                @relation("SourcingReferenceProduct", fields: [referenceProductId], references: [id], onDelete: SetNull)
  // P4.8: sales assignment + SLA (internal only, never in buyer responses).
  assignedToId       String?
  assignedTo         User?                   @relation("SourcingRequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  slaDueAt           DateTime?
  slaRemindedAt      DateTime?
  deletedAt          DateTime? // soft delete: quotes/order reference RFQs
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  attachments   SourcingRequestAttachment[]
  quotes        Quote[]
  selection     QuoteSelection?
  dealRoom      DealRoom?
  orders        Order[]
  internalNotes SourcingRequestNote[]
  invitations   SourcingRequestInvitation[]

  @@index([buyerId, status])
  @@index([status])
  @@index([assignedToId, status])
  @@index([slaDueAt])
  @@index([categoryId])
  @@index([referenceProductId])
  @@map("sourcing_requests")
}

// P4.9: sales invites specific suppliers to quote on an RFQ.
model SourcingRequestInvitation {
  id          String          @id @default(cuid())
  requestId   String
  request     SourcingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User            @relation("SourcingRequestInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  createdAt   DateTime        @default(now())

  @@unique([requestId, supplierId])
  @@index([supplierId])
  @@map("sourcing_request_invitations")
}

// P4.8: sales-only internal notes. Never returned to the buyer.
model SourcingRequestNote {
  id        String          @id @default(cuid())
  requestId String
  request   SourcingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String
  author    User            @relation("SourcingRequestNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  body      String          @db.VarChar(2000)
  createdAt DateTime        @default(now())

  @@index([requestId])
  @@map("sourcing_request_notes")
}

model SourcingRequestAttachment {
  id           String          @id @default(cuid())
  requestId    String
  request      SourcingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileObjectId String?
  fileObject   FileObject?     @relation(fields: [fileObjectId], references: [id], onDelete: SetNull)
  sortIndex    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([requestId])
  @@map("sourcing_request_attachments")
}

enum QuoteStatus {
  SUBMITTED
  SELECTED
  REJECTED
  EXPIRED
  // P4.9: supplier pulled the quote before any selection.
  WITHDRAWN
}

model Quote {
  id            String          @id @default(cuid())
  requestId     String
  request       SourcingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // Supplier identity is internal-only on public endpoints (P3.2 note).
  supplierId    String
  supplier      Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  unitPrice     Decimal         @db.Decimal(18, 2)
  currency      String          @default("VND") @db.VarChar(3)
  moq           Int             @default(1)
  leadTimeDays  Int             @default(7)
  validUntil    DateTime?
  // P4.9: delivery/incoterm conditions offered by the supplier.
  deliveryTerms String?         @db.VarChar(500)
  note          String?         @db.VarChar(1000)
  status        QuoteStatus     @default(SUBMITTED)
  selectedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  selection QuoteSelection?
  orders    Order[] // orders born from this quote (selectedQuote)

  @@index([requestId, status])
  @@index([supplierId])
  @@map("quotes")
}

// The one chosen quote per RFQ (P3.3).
model QuoteSelection {
  id          String          @id @default(cuid())
  requestId   String          @unique
  request     SourcingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  quoteId     String          @unique
  quote       Quote           @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  decidedById String
  decidedBy   User            @relation(fields: [decidedById], references: [id], onDelete: Restrict)
  note        String?         @db.VarChar(500)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("quote_selections")
}

// D7: 10 internal order states (todo.md 4A.4), transitions land in P4.16.
enum OrderStatus {
  NEGOTIATING
  SAMPLING
  CONTRACT
  DEPOSIT
  PRODUCTION
  QC
  FINAL_PAYMENT
  SHIPPING
  RECEIVED
  COMPLETED
  CANCELLED
}

model Order {
  id                String           @id @default(cuid())
  // Business number, format "CVC-ORD-..." (P3.3).
  orderNo           String           @unique @db.VarChar(32)
  buyerId           String
  buyer             User             @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  supplierId        String
  supplier          Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  sourcingRequestId String?
  sourcingRequest   SourcingRequest? @relation(fields: [sourcingRequestId], references: [id], onDelete: SetNull)
  selectedQuoteId   String?
  selectedQuote     Quote?           @relation(fields: [selectedQuoteId], references: [id], onDelete: SetNull)
  status            OrderStatus      @default(NEGOTIATING)
  stageIndex        Int              @default(0)
  totalAmount       Decimal          @db.Decimal(18, 2)
  depositAmount     Decimal?         @db.Decimal(18, 2)
  currency          String           @default("VND") @db.VarChar(3)
  note              String?          @db.VarChar(1000)
  // Orders are money records: no delete, no soft delete.
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  stageLogs    OrderStageLog[]
  events       OrderEvent[]
  samples      Sample[]
  shipments    Shipment[]
  claims       Claim[]
  refunds      Refund[]
  dealRoom     DealRoom?
  qcReports    QcReport[]
  LockedTerms  LockedTerms?
  invoices     Invoice[]
  sourcingCase SourcingCase?   @relation("SourcingCaseOrder")

  @@index([buyerId, status])
  @@index([supplierId, status])
  @@index([status])
  @@map("orders")
}

// One row per stage transition (audit of the D7 flow).
model OrderStageLog {
  id         String      @id @default(cuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stageIndex Int
  status     OrderStatus
  actorId    String?
  note       String?     @db.VarChar(500)
  occurredAt DateTime    @default(now())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([orderId, stageIndex])
  @@map("order_stage_logs")
}

// Fine-grained order events (messages, payment proofs, QC...).
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String   @db.VarChar(64)
  actorId   String?
  message   String?  @db.VarChar(500)
  data      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, createdAt])
  @@map("order_events")
}

enum SampleStatus {
  REQUESTED
  SHIPPED
  DELIVERED
  APPROVED
  REJECTED
  STOPPED
}

model Sample {
  id          String       @id @default(cuid())
  // Business number, format "CVC-SMP-..." (P3.3).
  sampleNo    String       @unique @db.VarChar(32)
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      SampleStatus @default(REQUESTED)
  note        String?      @db.VarChar(500)
  requestedAt DateTime     @default(now())
  shippedAt   DateTime?
  deliveredAt DateTime?
  decidedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  stops SampleStop[]

  @@index([orderId])
  @@map("samples")
}

// Manual pause/resume records while the sample is being made.
model SampleStop {
  id        String   @id @default(cuid())
  sampleId  String
  sample    Sample   @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  reason    String   @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sampleId])
  @@map("sample_stops")
}

enum ShipmentStatus {
  PREPARING
  IN_TRANSIT
  DELIVERED
  RETURNED
}

model Shipment {
  id                String         @id @default(cuid())
  orderId           String
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Carrier is entered by hand (no carrier table in P3.3).
  carrier           String         @db.VarChar(100)
  trackingNo        String         @db.VarChar(100)
  trackingUrl       String?        @db.VarChar(500)
  proofFileObjectId String?
  proofFile         FileObject?    @relation(fields: [proofFileObjectId], references: [id], onDelete: SetNull)
  status            ShipmentStatus @default(PREPARING)
  shippedAt         DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  stops       ShipmentStop[]
  inspections Inspection[]

  @@index([orderId])
  @@index([trackingNo])
  @@map("shipments")
}

// Hand-entered tracking milestones (time, description, entered by).
model ShipmentStop {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  occurredAt  DateTime
  description String   @db.VarChar(500)
  enteredById String
  enteredBy   User     @relation(fields: [enteredById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shipmentId, occurredAt])
  @@map("shipment_stops")
}

enum ClaimStatus {
  OPEN
  PROPOSED
  RESOLVED
  REJECTED
  CANCELLED
}

enum ClaimType {
  QUALITY
  DAMAGED
  MISSING
  WRONG_ITEM
  OTHER
}

model Claim {
  id        String      @id @default(cuid())
  // Business number, format "CVC-CLM-..." (P3.3).
  claimNo   String      @unique @db.VarChar(32)
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      ClaimType
  reason    String      @db.VarChar(2000)
  status    ClaimStatus @default(OPEN)
  filedById String
  filedBy   User        @relation(fields: [filedById], references: [id], onDelete: Restrict)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  proposals  ClaimProposal[]
  resolution ClaimResolution?
  returns    ReturnShipment[]
  refunds    Refund[]

  @@index([orderId, status])
  @@map("claims")
}

enum ClaimProposalKind {
  REFUND
  PARTIAL_REFUND
  RETURN
  REPLACE
  COMPENSATE
}

enum ClaimProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  WITHDRAWN
}

model ClaimProposal {
  id           String              @id @default(cuid())
  claimId      String
  claim        Claim               @relation(fields: [claimId], references: [id], onDelete: Cascade)
  kind         ClaimProposalKind
  // Monetary part of the proposal (null for pure return/replace).
  amount       Decimal?            @db.Decimal(18, 2)
  currency     String              @default("VND") @db.VarChar(3)
  note         String?             @db.VarChar(1000)
  status       ClaimProposalStatus @default(PENDING)
  proposedById String
  proposedBy   User                @relation(fields: [proposedById], references: [id], onDelete: Restrict)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([claimId])
  @@map("claim_proposals")
}

enum ResolutionDecision {
  REFUND
  PARTIAL_REFUND
  REPLACE
  COMPENSATE
  REJECT
}

// Final decision of a claim: one row per claim.
model ClaimResolution {
  id          String             @id @default(cuid())
  claimId     String             @unique
  claim       Claim              @relation(fields: [claimId], references: [id], onDelete: Cascade)
  decision    ResolutionDecision
  note        String?            @db.VarChar(1000)
  decidedById String
  decidedBy   User               @relation(fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt   DateTime           @default(now())
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("claim_resolutions")
}

enum ReturnDirection {
  RETURN_TO_SUPPLIER
  REPLACEMENT_TO_BUYER
}

model ReturnShipment {
  id                String          @id @default(cuid())
  claimId           String
  claim             Claim           @relation(fields: [claimId], references: [id], onDelete: Cascade)
  direction         ReturnDirection
  carrier           String          @db.VarChar(100)
  trackingNo        String          @db.VarChar(100)
  proofFileObjectId String?
  proofFile         FileObject?     @relation(fields: [proofFileObjectId], references: [id], onDelete: SetNull)
  status            ShipmentStatus  @default(PREPARING)
  shippedAt         DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([claimId])
  @@map("return_shipments")
}

enum RefundMethod {
  BANK_TRANSFER
  WALLET
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Refund {
  id            String       @id @default(cuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  claimId       String?
  claim         Claim?       @relation(fields: [claimId], references: [id], onDelete: SetNull)
  // Bank transfer target; null for wallet refunds.
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  amount        Decimal      @db.Decimal(18, 2)
  currency      String       @default("VND") @db.VarChar(3)
  method        RefundMethod
  status        RefundStatus @default(PENDING)
  // Loose external payment reference (Payment table arrives in P3.9).
  paymentRef    String?      @db.VarChar(64)
  note          String?      @db.VarChar(500)
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([orderId, status])
  @@index([claimId])
  @@map("refunds")
}

// ---------------------------------------------------------------------------
// P3.4 — Deal room (chat, offers, locked terms)
// ---------------------------------------------------------------------------

enum DealRoomStatus {
  OPEN
  LOCKED
  CLOSED
}

// One room per order, or per RFQ before it converts to an order (P3.4).
model DealRoom {
  id                String           @id @default(cuid())
  orderId           String?          @unique
  order             Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sourcingRequestId String?          @unique
  sourcingRequest   SourcingRequest? @relation(fields: [sourcingRequestId], references: [id], onDelete: Cascade)
  title             String?          @db.VarChar(200)
  status            DealRoomStatus   @default(OPEN)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  members  DealRoomMember[]
  messages Message[]
  offers   Offer[]

  @@index([status])
  @@map("deal_rooms")
}

model DealRoomMember {
  id        String   @id @default(cuid())
  roomId    String
  room      DealRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // buyer | supplier | sales | admin | ...
  role      String   @default("member") @db.VarChar(32)
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, userId])
  @@index([userId])
  @@map("deal_room_members")
}

enum MessageType {
  TEXT
  SYSTEM
  OFFER
}

model Message {
  id        String      @id @default(cuid())
  roomId    String
  room      DealRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId  String?
  sender    User?       @relation(fields: [senderId], references: [id], onDelete: SetNull)
  type      MessageType @default(TEXT)
  body      String      @db.VarChar(2000)
  data      Json?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  attachments  MessageAttachment[]
  translations Translation[]
  Offer        Offer[]

  @@index([roomId, createdAt])
  @@map("deal_messages")
}

model MessageAttachment {
  id           String      @id @default(cuid())
  messageId    String
  message      Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileObjectId String?
  fileObject   FileObject? @relation(fields: [fileObjectId], references: [id], onDelete: SetNull)
  sortIndex    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([messageId])
  @@map("message_attachments")
}

// Per-language translation of a room message (P3.4).
model Translation {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  lang      String   @db.VarChar(8)
  text      String   @db.VarChar(4000)
  // google | human | ...
  provider  String   @default("manual") @db.VarChar(32)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([messageId, lang])
  @@map("translations")
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  WITHDRAWN
}

model Offer {
  id          String      @id @default(cuid())
  roomId      String
  room        DealRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  // Optional link to the message that carried this offer.
  messageId   String?
  message     Message?    @relation(fields: [messageId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  unitPrice   Decimal     @db.Decimal(18, 2)
  currency    String      @default("VND") @db.VarChar(3)
  quantity    Int
  conditions  String?     @db.VarChar(1000)
  status      OfferStatus @default(PENDING)
  validUntil  DateTime?
  decidedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([roomId, status])
  @@map("offers")
}

// Immutable snapshot of the agreed terms at lock time (P3.4): a trigger in
// the migration blocks UPDATE; rows are only ever inserted.
model LockedTerms {
  id         String   @id @default(cuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  terms      Json
  currency   String   @default("VND") @db.VarChar(3)
  lockedById String
  lockedBy   User     @relation(fields: [lockedById], references: [id], onDelete: Restrict)
  lockedAt   DateTime @default(now())
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("locked_terms")
}

// ---------------------------------------------------------------------------
// P3.5 — Contracts
// ---------------------------------------------------------------------------

enum ContractType {
  SOURCING
  PARTICIPATION
  RETAIL
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ContractSignMethod {
  OTP
  E_SIGN
  WET_INK
  MANUAL
}

model ContractTemplate {
  id        String       @id @default(cuid())
  type      ContractType
  version   Int
  title     String       @db.VarChar(200)
  // Body with {{variable}} placeholders.
  content   String       @db.Text
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  contracts Contract[]

  @@unique([type, version])
  @@map("contract_templates")
}

model Contract {
  id                 String           @id @default(cuid())
  // Loose owner reference: sourcing_order | campaign | consignment | ...
  ownerType          String           @db.VarChar(32)
  ownerId            String           @db.VarChar(64)
  templateId         String
  template           ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion    Int
  status             ContractStatus   @default(DRAFT)
  providerRef        String?          @db.VarChar(64)
  signedFileObjectId String?
  signedFile         FileObject?      @relation(fields: [signedFileObjectId], references: [id], onDelete: SetNull)
  fileHash           String?          @db.VarChar(64)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  versions   ContractVersion[]
  parties    ContractParty[]
  signatures ContractSignature[]

  @@index([ownerType, ownerId])
  @@index([status])
  @@map("contracts")
}

// Append-only content history; after SIGNED the contract never gets a new
// version (service-level rule, P3.5).
model ContractVersion {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  version    Int
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([contractId, version])
  @@map("contract_versions")
}

model ContractParty {
  id          String   @id @default(cuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  // buyer | supplier | cvc | witness | ...
  role        String   @db.VarChar(32)
  displayName String   @db.VarChar(191)
  // Platform user when the party is an account, null for external parties.
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  contact     String?  @db.VarChar(191)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  signatures ContractSignature[]

  @@unique([contractId, role])
  @@index([userId])
  @@map("contract_parties")
}

model ContractSignature {
  id             String             @id @default(cuid())
  contractId     String
  contract       Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  partyId        String
  party          ContractParty      @relation(fields: [partyId], references: [id], onDelete: Cascade)
  method         ContractSignMethod @default(MANUAL)
  providerRef    String?            @db.VarChar(64)
  signedByUserId String?
  signedBy       User?              @relation(fields: [signedByUserId], references: [id], onDelete: SetNull)
  signedAt       DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([contractId, partyId])
  @@map("contract_signatures")
}

// ---------------------------------------------------------------------------
// P3.6 — Group buy (mua hộ)
// ---------------------------------------------------------------------------

// D7-aligned demo flow: 7 steps (stage 0-6 in legacy domain.js).
enum CampaignStage {
  REGISTRATION
  DEPOSIT
  PRODUCTION
  IMPORT
  ALLOCATION
  RETAIL
  DONE
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
  CANCELLED
}

enum RiskKind {
  DEMAND
  SUPPLY
  LOGISTICS
  FX
  OTHER
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model Campaign {
  id                   String         @id @default(cuid())
  name                 String         @db.VarChar(200)
  capacity             Int
  stage                CampaignStage  @default(REGISTRATION)
  status               CampaignStatus @default(DRAFT)
  deadline             DateTime?
  supplierId           String?
  supplier             Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdById          String
  createdBy            User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  // Economic parameters per D4 (per campaign, overridable per line).
  costPrice            Decimal        @db.Decimal(18, 2)
  retailPrice          Decimal        @db.Decimal(18, 2)
  currency             String         @default("VND") @db.VarChar(3)
  participantShareRate Decimal        @db.Decimal(6, 4)
  retailerShareRate    Decimal        @db.Decimal(6, 4)
  cvcFeeRate           Decimal        @db.Decimal(6, 4)
  logisticsCost        Decimal?       @db.Decimal(18, 2)
  storageCost          Decimal?       @db.Decimal(18, 2)
  otherCost            Decimal?       @db.Decimal(18, 2)
  depositRate          Decimal        @default(0.3000) @db.Decimal(6, 4)
  returnAfterDays      Int            @default(45) // D5
  returnBonusRate      Decimal        @default(0.0300) @db.Decimal(6, 4) // D5
  deletedAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  lines          CampaignLine[]
  stageLogs      CampaignStageLog[]
  surveys        CampaignSurvey[]
  risks          CampaignRisk[]
  participations Participation[]
  goodsRequests  GoodsRequest[]
  returnRequests ReturnRequest[]
  allocations    Allocation[]
  transfers      Transfer[]
  resaleListings ResaleListing[]
  Sale           Sale[]
  InventoryLot   InventoryLot[]

  @@index([status, stage])
  @@map("campaigns")
}

model CampaignLine {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  plannedQty Int
  unitPrice  Decimal? @db.Decimal(18, 2)
  currency   String   @default("VND") @db.VarChar(3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campaignId, productId])
  @@map("campaign_lines")
}

model CampaignStageLog {
  id         String        @id @default(cuid())
  campaignId String
  campaign   Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stage      CampaignStage
  actorId    String?
  actor      User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  note       String?       @db.VarChar(500)
  occurredAt DateTime      @default(now())
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([campaignId, occurredAt])
  @@map("campaign_stage_logs")
}

// Purchasing-power survey for a campaign (P3.6).
model CampaignSurvey {
  id          String    @id @default(cuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  title       String?   @db.VarChar(200)
  payload     Json?
  result      Json?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([campaignId])
  @@map("campaign_surveys")
}

model CampaignRisk {
  id           String    @id @default(cuid())
  campaignId   String
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  kind         RiskKind
  level        RiskLevel
  note         String?   @db.VarChar(1000)
  mitigation   String?   @db.VarChar(1000)
  recordedById String
  recordedBy   User      @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([campaignId])
  @@map("campaign_risks")
}

enum ParticipationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// Capacity is DB-enforced: a trigger in the migration rejects inserts/updates
// where SUM(unitsBought) over the campaign would exceed capacity (P3.6).
model Participation {
  id          String              @id @default(cuid())
  campaignId  String
  campaign    Campaign            @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  amountPaid  Decimal             @default(0) @db.Decimal(18, 2)
  currency    String              @default("VND") @db.VarChar(3)
  unitsBought Int                 @default(0) // integer only
  status      ParticipationStatus @default(PENDING)
  joinedAt    DateTime            @default(now())
  note        String?             @db.VarChar(500)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  lines          ParticipationLine[]
  returnRequests ReturnRequest[]

  @@unique([campaignId, userId])
  @@index([userId])
  @@map("participations")
}

model ParticipationLine {
  id              String        @id @default(cuid())
  participationId String
  participation   Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitsBought     Int
  unitPrice       Decimal       @db.Decimal(18, 2)
  currency        String        @default("VND") @db.VarChar(3)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([participationId, productId])
  @@map("participation_lines")
}

enum GoodsRequestStatus {
  OPEN
  APPROVED
  REJECTED
  CANCELLED
  FULFILLED
}

// A store requests goods from a campaign (P3.6).
model GoodsRequest {
  id          String             @id @default(cuid())
  campaignId  String
  campaign    Campaign           @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  storeId     String
  store       Store              @relation(fields: [storeId], references: [id], onDelete: Restrict)
  quantity    Int
  note        String?            @db.VarChar(500)
  status      GoodsRequestStatus @default(OPEN)
  handledById String?
  handledBy   User?              @relation(fields: [handledById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  allocations Allocation[]

  @@index([campaignId, status])
  @@index([storeId])
  @@map("goods_requests")
}

enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

// 45-day + 3% return program (D5) at request level; money lands in P3.9.
model ReturnRequest {
  id              String              @id @default(cuid())
  campaignId      String
  campaign        Campaign            @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  storeId         String?
  store           Store?              @relation(fields: [storeId], references: [id], onDelete: Restrict)
  participationId String?
  participation   Participation?      @relation(fields: [participationId], references: [id], onDelete: SetNull)
  quantity        Int
  reason          String?             @db.VarChar(1000)
  status          ReturnRequestStatus @default(REQUESTED)
  decidedById     String?
  decidedBy       User?               @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  processedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([campaignId, status])
  @@map("return_requests")
}

// ---------------------------------------------------------------------------
// P3.7 — Resale (bán giùm)
// ---------------------------------------------------------------------------

enum RetailerStatus {
  PENDING
  APPROVED
  REJECTED
  DISABLED
}

model RetailerRegistration {
  id           String         @id @default(cuid())
  userId       String         @unique
  user         User           @relation("RetailerOwner", fields: [userId], references: [id], onDelete: Restrict)
  businessName String?        @db.VarChar(191)
  taxId        String?        @db.VarChar(32)
  phone        String?        @db.VarChar(20)
  status       RetailerStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?          @relation("RetailerReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  note         String?        @db.VarChar(500)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("retailer_registrations")
}

model Store {
  id        String    @id @default(cuid())
  ownerId   String?
  owner     User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  name      String    @db.VarChar(191)
  code      String?   @unique @db.VarChar(32)
  province  String?   @db.VarChar(100)
  district  String?   @db.VarChar(100)
  address   String?   @db.VarChar(500)
  phone     String?   @db.VarChar(20)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  goodsRequests  GoodsRequest[]
  returnRequests ReturnRequest[]
  allocations    Allocation[]
  transfersFrom  Transfer[]      @relation("TransferFrom")
  transfersTo    Transfer[]      @relation("TransferTo")
  resaleListings ResaleListing[]
  sales          Sale[]
  saleImports    SaleImport[]
  crmContacts    CrmContact[]
  showroomVisits ShowroomVisit[]

  @@index([ownerId])
  @@map("stores")
}

enum AllocationStatus {
  ALLOCATED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model Allocation {
  id             String           @id @default(cuid())
  campaignId     String
  campaign       Campaign         @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  storeId        String
  store          Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  goodsRequestId String?
  goodsRequest   GoodsRequest?    @relation(fields: [goodsRequestId], references: [id], onDelete: SetNull)
  allocatedById  String
  allocatedBy    User             @relation(fields: [allocatedById], references: [id], onDelete: Restrict)
  status         AllocationStatus @default(ALLOCATED)
  allocatedAt    DateTime         @default(now())
  receivedAt     DateTime?
  note           String?          @db.VarChar(500)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  lines AllocationLine[]

  @@index([campaignId])
  @@index([storeId, status])
  @@map("allocations")
}

model AllocationLine {
  id           String     @id @default(cuid())
  allocationId String
  allocation   Allocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity     Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([allocationId, productId])
  @@map("allocation_lines")
}

enum TransferStatus {
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

// Store-to-store transfer of campaign goods (P3.7).
model Transfer {
  id           String         @id @default(cuid())
  fromStoreId  String
  fromStore    Store          @relation("TransferFrom", fields: [fromStoreId], references: [id], onDelete: Restrict)
  toStoreId    String
  toStore      Store          @relation("TransferTo", fields: [toStoreId], references: [id], onDelete: Restrict)
  campaignId   String?
  campaign     Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  quantity     Int
  status       TransferStatus @default(IN_TRANSIT)
  sentById     String?
  sentBy       User?          @relation("TransferSender", fields: [sentById], references: [id], onDelete: SetNull)
  sentAt       DateTime       @default(now())
  receivedById String?
  receivedBy   User?          @relation("TransferReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  receivedAt   DateTime?
  note         String?        @db.VarChar(500)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  receipts TransferReceipt[]

  @@index([campaignId])
  @@map("transfers")
}

model TransferReceipt {
  id           String      @id @default(cuid())
  transferId   String
  transfer     Transfer    @relation(fields: [transferId], references: [id], onDelete: Cascade)
  fileObjectId String?
  fileObject   FileObject? @relation(fields: [fileObjectId], references: [id], onDelete: SetNull)
  uploadedById String?
  uploadedBy   User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  note         String?     @db.VarChar(500)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([transferId])
  @@map("transfer_receipts")
}

// Retail offer derived from a lot/campaign: price + retailer earning (P3.7).
model ResaleListing {
  id                  String        @id @default(cuid())
  campaignId          String?
  campaign            Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  productId           String
  product             Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  lotId               String?
  lot                 InventoryLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)
  storeId             String?
  store               Store?        @relation(fields: [storeId], references: [id], onDelete: SetNull)
  title               String?       @db.VarChar(200)
  salePrice           Decimal       @db.Decimal(18, 2)
  retailerShareAmount Decimal?      @db.Decimal(18, 2)
  currency            String        @default("VND") @db.VarChar(3)
  quantityRemaining   Int
  isActive            Boolean       @default(true)
  deletedAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([productId, isActive])
  @@map("resale_listings")
}

// ---------------------------------------------------------------------------
// P3.8 — Sales & inventory
// ---------------------------------------------------------------------------

model Sale {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  soldById    String?
  soldBy      User?     @relation(fields: [soldById], references: [id], onDelete: SetNull)
  soldAt      DateTime  @default(now())
  totalAmount Decimal   @db.Decimal(18, 2)
  currency    String    @default("VND") @db.VarChar(3)
  note        String?   @db.VarChar(500)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lines SaleLine[]

  @@index([storeId, soldAt])
  @@index([campaignId])
  @@map("sales")
}

model SaleLine {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal  @db.Decimal(18, 2)
  currency  String   @default("VND") @db.VarChar(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleId])
  @@map("sale_lines")
}

enum SaleImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

// CSV import batch; fileHash unique blocks re-importing the same file (P3.8).
model SaleImport {
  id           String           @id @default(cuid())
  fileName     String           @db.VarChar(255)
  // SHA-256 of the file content; unique = dedupe at DB level.
  fileHash     String           @unique @db.VarChar(64)
  storeId      String
  store        Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  totalRows    Int
  successRows  Int              @default(0)
  failedRows   Int              @default(0)
  status       SaleImportStatus @default(PENDING)
  uploadedById String?
  uploadedBy   User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("sale_imports")
}

model InventoryLot {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  lotNo      String?   @db.VarChar(64)
  expiryAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  movements      InventoryMovement[]
  balances       InventoryBalance[]
  stockCounts    StockCount[]
  inspections    Inspection[]
  qcReports      QcReport[]
  resaleListings ResaleListing[]

  @@index([productId])
  @@map("inventory_lots")
}

enum MovementType {
  RECEIVE
  ISSUE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUST
}

// Append-only stock ledger (P3.8): a trigger in the migration blocks UPDATE;
// stock = SUM(quantity). storeId null = central warehouse.
model InventoryMovement {
  id            String       @id @default(cuid())
  lotId         String
  lot           InventoryLot @relation(fields: [lotId], references: [id], onDelete: Restrict)
  // Raw store reference; null = central. Kept loose so balances stay keyable.
  storeId       String?      @db.VarChar(64)
  type          MovementType
  // Signed: positive in, negative out.
  quantity      Int
  referenceType String?      @db.VarChar(32)
  referenceId   String?      @db.VarChar(64)
  note          String?      @db.VarChar(500)
  createdById   String
  createdBy     User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([lotId, createdAt])
  @@index([storeId])
  @@map("inventory_movements")
}

// Aggregate kept in the same transaction as movements (P3.8).
// storeId "" = central warehouse so the unique key works with NOT NULL.
model InventoryBalance {
  id        String       @id @default(cuid())
  lotId     String
  lot       InventoryLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  storeId   String       @default("") @db.VarChar(64)
  quantity  Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([lotId, storeId])
  @@index([storeId])
  @@map("inventory_balances")
}

model StockCount {
  id              String       @id @default(cuid())
  lotId           String
  lot             InventoryLot @relation(fields: [lotId], references: [id], onDelete: Restrict)
  storeId         String?      @db.VarChar(64) // null = central
  countedQuantity Int
  countedById     String
  countedBy       User         @relation(fields: [countedById], references: [id], onDelete: Restrict)
  countedAt       DateTime     @default(now())
  note            String?      @db.VarChar(500)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([lotId])
  @@map("stock_counts")
}

enum InspectionResult {
  PASSED
  PARTIAL
  FAILED
}

model Inspection {
  id            String           @id @default(cuid())
  shipmentId    String?
  shipment      Shipment?        @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  lotId         String?
  lot           InventoryLot?    @relation(fields: [lotId], references: [id], onDelete: SetNull)
  result        InspectionResult
  inspectedById String
  inspectedBy   User             @relation(fields: [inspectedById], references: [id], onDelete: Restrict)
  inspectedAt   DateTime         @default(now())
  note          String?          @db.VarChar(1000)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  photos InspectionPhoto[]

  @@index([shipmentId])
  @@index([lotId])
  @@map("inspections")
}

model InspectionPhoto {
  id           String      @id @default(cuid())
  inspectionId String
  inspection   Inspection  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  fileObjectId String?
  fileObject   FileObject? @relation(fields: [fileObjectId], references: [id], onDelete: SetNull)
  sortIndex    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([inspectionId])
  @@map("inspection_photos")
}

model QcReport {
  id          String        @id @default(cuid())
  orderId     String?
  order       Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  lotId       String?
  lot         InventoryLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)
  passed      Boolean
  checkedById String
  checkedBy   User          @relation(fields: [checkedById], references: [id], onDelete: Restrict)
  checkedAt   DateTime      @default(now())
  // Checklist answers (template item -> pass/fail/notes).
  items       Json?
  note        String?       @db.VarChar(1000)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId])
  @@map("qc_reports")
}

model QcChecklistTemplate {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(191)
  // [{ key, label, required }, ...]
  items     Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("qc_checklist_templates")
}

// ---------------------------------------------------------------------------
// P3.9 — Money: wallets, double-entry ledger, payments, payouts, recon.
// D13: payments are manual P2P bank transfers with uploaded proof; admin
// confirms against imported bank statement lines. The ledger is the source of
// truth for money: LedgerEntry rows are immutable (DB trigger blocks
// UPDATE/DELETE unless the operator sets @cvc_ledger_unlocked) and every
// LedgerTransaction must balance (SUM debit = SUM credit, DB-enforced).
// ---------------------------------------------------------------------------

enum WalletStatus {
  ACTIVE
  FROZEN
}

model Wallet {
  id        String       @id @default(cuid())
  userId    String       @unique
  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  currency  String       @default("VND") @db.VarChar(3)
  // Never goes negative: CHECK in the migration + service-level guard.
  balance   Decimal      @default(0) @db.Decimal(18, 2)
  status    WalletStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  accounts    LedgerAccount[]
  withdrawals Withdrawal[]

  @@map("wallets")
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model LedgerAccount {
  id        String            @id @default(cuid())
  // Stable code, e.g. "CVC-CASH", "USR-{userId}".
  code      String            @unique @db.VarChar(64)
  name      String            @db.VarChar(191)
  type      LedgerAccountType
  walletId  String?
  wallet    Wallet?           @relation(fields: [walletId], references: [id], onDelete: SetNull)
  currency  String            @default("VND") @db.VarChar(3)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  entries LedgerEntry[]

  @@map("ledger_accounts")
}

enum LedgerTransactionType {
  DEPOSIT
  PAYMENT
  PAYOUT
  FEE
  REFUND
  ADJUSTMENT
  SETTLEMENT
  OTHER
}

enum LedgerTransactionStatus {
  DRAFT
  POSTED
  VOID
}

model LedgerTransaction {
  id              String                  @id @default(cuid())
  // How many entries this transaction carries (normally 2). The DB trigger
  // `ledger_entries_balanced` checks debit/credit sums once the count is met.
  expectedEntries Int                     @default(2)
  type            LedgerTransactionType   @default(OTHER)
  status          LedgerTransactionStatus @default(DRAFT)
  currency        String                  @default("VND") @db.VarChar(3)
  postedAt        DateTime?
  // Free-form business reference, e.g. payment/payout/campaign id.
  refType         String?                 @db.VarChar(32)
  refId           String?                 @db.VarChar(64)
  note            String?                 @db.VarChar(500)
  createdById     String
  createdBy       User                    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  entries LedgerEntry[]

  @@index([refType, refId])
  @@index([status, postedAt])
  @@map("ledger_transactions")
}

enum LedgerSide {
  DEBIT
  CREDIT
}

// Immutable money movement rows (P3.9): triggers in the migration block
// UPDATE and DELETE unless @cvc_ledger_unlocked is set for the session.
// amount > 0 is enforced by a CHECK constraint; side carries the direction.
model LedgerEntry {
  id            String            @id @default(cuid())
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  accountId     String
  account       LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  side          LedgerSide
  amount        Decimal           @db.Decimal(18, 2)
  refType       String?           @db.VarChar(32)
  refId         String?           @db.VarChar(64)
  note          String?           @db.VarChar(500)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([transactionId])
  @@index([accountId])
  @@map("ledger_entries")
}

// Bank account that receives customer money (CVC's own accounts, D13).
// Same encryption pattern as BankAccount: enc + last4 + sha256 hash for
// uniqueness without decryption.
model ReceivingAccount {
  id             String   @id @default(cuid())
  bankName       String   @db.VarChar(100)
  holderName     String   @db.VarChar(191)
  accountNoEnc   String   @db.VarChar(255)
  accountNoLast4 String   @db.VarChar(4)
  accountNoHash  String   @unique @db.VarChar(64)
  bankCode       String?  @db.VarChar(32)
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payments Payment[]

  @@map("receiving_accounts")
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  REFUNDED
}

// Manual transfer from a user to a receiving account (D13).
model Payment {
  id                 String           @id @default(cuid())
  paymentNo          String           @unique @db.VarChar(32) // CVC-PAY-...
  userId             String
  user               User             @relation("PaymentPayer", fields: [userId], references: [id], onDelete: Restrict)
  // Loose business purpose, e.g. order deposit / campaign participation.
  purposeType        String?          @db.VarChar(32)
  purposeId          String?          @db.VarChar(64)
  receivingAccountId String
  receivingAccount   ReceivingAccount @relation(fields: [receivingAccountId], references: [id], onDelete: Restrict)
  amount             Decimal          @db.Decimal(18, 2)
  currency           String           @default("VND") @db.VarChar(3)
  status             PaymentStatus    @default(PENDING)
  confirmedById      String?
  confirmedBy        User?            @relation("PaymentConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  receivedAt         DateTime? // when the bank transfer was made
  confirmedAt        DateTime?
  note               String?          @db.VarChar(500)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  proofs         PaymentProof[]
  statementLines BankStatementLine[]

  @@index([userId, status])
  @@index([purposeType, purposeId])
  @@index([status, createdAt])
  @@map("payments")
}

model PaymentProof {
  id           String      @id @default(cuid())
  paymentId    String
  payment      Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  fileObjectId String?
  fileObject   FileObject? @relation(fields: [fileObjectId], references: [id], onDelete: SetNull)
  // SHA-256 of the uploaded proof image: blocks reusing the same picture
  // across payments (checked in service; hash kept for dedupe).
  sha256       String      @db.VarChar(64)
  uploadedById String?
  uploadedBy   User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  note         String?     @db.VarChar(255)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([paymentId, sha256])
  @@index([sha256])
  @@map("payment_proofs")
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// Manual disbursement from CVC to a payee (supplier/retailer/participant, D13).
model Payout {
  id            String       @id @default(cuid())
  payoutNo      String       @unique @db.VarChar(32) // CVC-PO-...
  // Loose payee reference: supplier | retailer | participant | cvc.
  payeeType     String       @db.VarChar(32)
  payeeId       String       @db.VarChar(64)
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  amount        Decimal      @db.Decimal(18, 2)
  currency      String       @default("VND") @db.VarChar(3)
  status        PayoutStatus @default(PENDING)
  approvedById  String?
  approvedBy    User?        @relation("PayoutApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime?
  processedAt   DateTime?
  note          String?      @db.VarChar(500)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  proofs         PayoutProof[]
  statementLines BankStatementLine[]
  withdrawals    Withdrawal[]
  settlements    Settlement[]

  @@index([payeeType, payeeId])
  @@index([status])
  @@map("payouts")
}

model PayoutProof {
  id           String      @id @default(cuid())
  payoutId     String
  payout       Payout      @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  fileObjectId String?
  fileObject   FileObject? @relation(fields: [fileObjectId], references: [id], onDelete: SetNull)
  sha256       String      @db.VarChar(64)
  uploadedById String?
  uploadedBy   User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  note         String?     @db.VarChar(255)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([payoutId, sha256])
  @@map("payout_proofs")
}

enum BankStatementImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Imported bank statement file (CSV/PDF export); fileHash unique blocks
// importing the same statement twice (same dedupe pattern as SaleImport).
model BankStatementImport {
  id           String                    @id @default(cuid())
  fileName     String                    @db.VarChar(255)
  fileHash     String                    @unique @db.VarChar(64)
  status       BankStatementImportStatus @default(PENDING)
  totalLines   Int                       @default(0)
  importedById String?
  importedBy   User?                     @relation(fields: [importedById], references: [id], onDelete: SetNull)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  lines BankStatementLine[]

  @@map("bank_statement_imports")
}

enum BankStatementLineStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

model BankStatementLine {
  id               String                  @id @default(cuid())
  importId         String
  import           BankStatementImport     @relation(fields: [importId], references: [id], onDelete: Cascade)
  lineNo           Int
  transactionDate  DateTime
  description      String                  @db.VarChar(500)
  // Signed: credit (money in) positive, debit negative.
  amount           Decimal                 @db.Decimal(18, 2)
  reference        String?                 @db.VarChar(100)
  matchedPaymentId String?
  matchedPayment   Payment?                @relation(fields: [matchedPaymentId], references: [id], onDelete: SetNull)
  matchedPayoutId  String?
  matchedPayout    Payout?                 @relation(fields: [matchedPayoutId], references: [id], onDelete: SetNull)
  status           BankStatementLineStatus @default(UNMATCHED)
  matchedAt        DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([importId, lineNo])
  @@index([status])
  @@map("bank_statement_lines")
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// User request to withdraw wallet balance; payoutId links the executed payout.
model Withdrawal {
  id            String           @id @default(cuid())
  walletId      String
  wallet        Wallet           @relation(fields: [walletId], references: [id], onDelete: Restrict)
  amount        Decimal          @db.Decimal(18, 2)
  currency      String           @default("VND") @db.VarChar(3)
  bankAccountId String?
  bankAccount   BankAccount?     @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  status        WithdrawalStatus @default(PENDING)
  payoutId      String?
  payout        Payout?          @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  processedAt   DateTime?
  note          String?          @db.VarChar(500)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([walletId, status])
  @@map("withdrawals")
}

enum SettlementStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

// Period settlement with an owner (retailer/supplier) for consignment sales.
model Settlement {
  id           String           @id @default(cuid())
  settlementNo String           @unique @db.VarChar(32) // CVC-STL-...
  ownerType    String           @db.VarChar(32)
  ownerId      String           @db.VarChar(64)
  periodStart  DateTime
  periodEnd    DateTime
  amount       Decimal          @db.Decimal(18, 2)
  currency     String           @default("VND") @db.VarChar(3)
  status       SettlementStatus @default(PENDING)
  payoutId     String?
  payout       Payout?          @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  note         String?          @db.VarChar(500)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([ownerType, ownerId])
  @@map("settlements")
}

enum ReconciliationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

// One reconciliation pass comparing payments/payouts vs bank statements.
model ReconciliationRun {
  id         String                  @id @default(cuid())
  scope      String                  @default("payments") @db.VarChar(32)
  ranById    String?
  ranBy      User?                   @relation(fields: [ranById], references: [id], onDelete: SetNull)
  startedAt  DateTime                @default(now())
  finishedAt DateTime?
  status     ReconciliationRunStatus @default(RUNNING)
  // Aggregate result, e.g. { checked: 120, matched: 115, unmatched: 5 }.
  summary    Json?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  items ReconciliationItem[]

  @@index([status, startedAt])
  @@map("reconciliation_runs")
}

enum ReconciliationItemKind {
  MISSING
  MISMATCH
  DUPLICATE
  UNMATCHED
}

enum ReconciliationItemStatus {
  OPEN
  RESOLVED
  IGNORED
}

model ReconciliationItem {
  id           String                   @id @default(cuid())
  runId        String
  run          ReconciliationRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind         ReconciliationItemKind
  refType      String?                  @db.VarChar(32)
  refId        String?                  @db.VarChar(64)
  detail       Json?
  status       ReconciliationItemStatus @default(OPEN)
  resolvedById String?
  resolvedBy   User?                    @relation("ReconResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([runId, kind])
  @@index([status])
  @@map("reconciliation_items")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

model Invoice {
  id           String        @id @default(cuid())
  invoiceNo    String        @unique @db.VarChar(32) // CVC-INV-...
  ownerType    String        @db.VarChar(32)
  ownerId      String        @db.VarChar(64)
  orderId      String?
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amount       Decimal       @db.Decimal(18, 2)
  currency     String        @default("VND") @db.VarChar(3)
  status       InvoiceStatus @default(DRAFT)
  issuedAt     DateTime?
  fileObjectId String?
  fileObject   FileObject?   @relation(fields: [fileObjectId], references: [id], onDelete: SetNull)
  note         String?       @db.VarChar(500)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([ownerType, ownerId])
  @@index([status])
  @@map("invoices")
}

enum ExchangeRateSource {
  MANUAL
  AUTO
}

model ExchangeRate {
  id          String             @id @default(cuid())
  baseCode    String             @db.VarChar(3) // e.g. CNY
  quoteCode   String             @db.VarChar(3) // e.g. VND
  rate        Decimal            @db.Decimal(18, 8)
  effectiveAt DateTime
  source      ExchangeRateSource @default(MANUAL)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([baseCode, quoteCode, effectiveAt])
  @@map("exchange_rates")
}

// ---------------------------------------------------------------------------
// P3.10 — Misc: funding applications, CRM, showroom visits, saved reports.
// (Notification, NotificationPreference, AuditLog, SystemSetting,
// IdempotencyKey already exist from P2.)
// ---------------------------------------------------------------------------

enum FundingStatus {
  PENDING
  APPROVED
  REJECTED
}

model FundingApplication {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  amountRequested Decimal       @db.Decimal(18, 2)
  currency        String        @default("VND") @db.VarChar(3)
  purpose         String        @db.VarChar(1000)
  status          FundingStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?         @relation("FundingReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  reviewNote      String?       @db.VarChar(500)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("funding_applications")
}

enum CrmActivityType {
  CALL
  EMAIL
  VISIT
  NOTE
  OTHER
}

model CrmContact {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(191)
  phone     String?   @db.VarChar(20)
  email     String?   @db.VarChar(191)
  // buyer | supplier | retailer | lead | ...
  type      String    @default("lead") @db.VarChar(32)
  // Optional link to a platform account.
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  storeId   String?
  store     Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)
  notes     String?   @db.Text
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  activities CrmActivity[]
  visits     ShowroomVisit[]

  @@index([type])
  @@index([phone])
  @@map("crm_contacts")
}

model CrmActivity {
  id         String          @id @default(cuid())
  contactId  String
  contact    CrmContact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type       CrmActivityType
  subject    String          @db.VarChar(200)
  content    String?         @db.Text
  occurredAt DateTime        @default(now())
  actorId    String?
  actor      User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([contactId, occurredAt])
  @@map("crm_activities")
}

enum ShowroomVisitStatus {
  SCHEDULED
  DONE
  CANCELLED
  NO_SHOW
}

model ShowroomVisit {
  id          String              @id @default(cuid())
  contactId   String
  contact     CrmContact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  storeId     String?
  store       Store?              @relation(fields: [storeId], references: [id], onDelete: SetNull)
  scheduledAt DateTime
  visitedAt   DateTime?
  status      ShowroomVisitStatus @default(SCHEDULED)
  note        String?             @db.VarChar(500)
  actorId     String?
  actor       User?               @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([contactId])
  @@index([scheduledAt])
  @@map("showroom_visits")
}

enum ReportStatus {
  DRAFT
  READY
  FAILED
}

// Saved/parameterized report definition (revenue, stock, reconciliation...).
model Report {
  id            String       @id @default(cuid())
  name          String       @db.VarChar(191)
  type          String       @db.VarChar(32) // revenue | stock | recon | ...
  params        Json?
  result        Json?
  status        ReportStatus @default(READY)
  generatedById String?
  generatedBy   User?        @relation(fields: [generatedById], references: [id], onDelete: SetNull)
  generatedAt   DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([type])
  @@map("reports")
}

// ---------------------------------------------------------------------------
// P4.3 — Published sourcing cases (hồ sơ tìm nguồn đã hỗ trợ, công khai).
// One link row per completed order that sales "published" as a public catalog
// item: the case product is a copy of the source product (category, specs,
// images) with no buyer/supplier identity anywhere.
// ---------------------------------------------------------------------------

model SourcingCase {
  id              String   @id @default(cuid())
  orderId         String   @unique
  order           Order    @relation("SourcingCaseOrder", fields: [orderId], references: [id], onDelete: Restrict)
  // The catalog product the case study is based on.
  sourceProductId String
  sourceProduct   Product  @relation("SourcingCaseSource", fields: [sourceProductId], references: [id], onDelete: Restrict)
  // The public catalog item created for the case (sku CVC-CASE-...).
  caseProductId   String   @unique
  caseProduct     Product  @relation("SourcingCaseItem", fields: [caseProductId], references: [id], onDelete: Restrict)
  publishedById   String
  publishedBy     User     @relation("SourcingCasePublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sourceProductId])
  @@map("sourcing_cases")
}
