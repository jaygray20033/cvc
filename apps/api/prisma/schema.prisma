// CVC Prisma schema. The full data model lands in later phases (P2+); see docs/erd.md.
// Naming: tables plural snake_case via @@map; columns camelCase in code via @map.
// Money: Decimal + a currency column (VND/CNY). Never float. Migrations additive only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Foundational idempotency table (CLAUDE.md: every money API takes an Idempotency-Key).
// Replaying the same key must not create a second transaction.
model IdempotencyKey {
  key         String   @id @db.VarChar(191)
  scope       String   @db.VarChar(100)
  requestHash String   @db.VarChar(64)
  response    Json?
  createdAt   DateTime @default(now())

  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Auth domain (P2.1–P2.4). Roles/KYC/organizations land in P2.7+ / P3.1.
// Secrets are never stored in plaintext: passwords are argon2id hashes, email
// verification / password-reset tokens and OTP codes are stored as SHA-256
// hashes, refresh tokens are stored hashed inside Session.
// ---------------------------------------------------------------------------

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique @db.VarChar(191)
  emailVerifiedAt DateTime?
  phone           String?     @unique @db.VarChar(20)
  passwordHash    String?     @db.VarChar(255)
  status          UserStatus  @default(PENDING_VERIFICATION)
  // TOTP 2FA (P2.5). Secret is AES-256-GCM encrypted (ENCRYPTION_KEY);
  // totpSecret set but totpEnabledAt null = setup in progress.
  totpSecret      String?     @db.VarChar(255)
  totpEnabledAt   DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  sessions           Session[]
  verificationTokens VerificationToken[]
  recoveryCodes      RecoveryCode[]
  userRoles          UserRole[]

  @@map("users")
}

// Platform roles per user (P2.9). Source of truth for RBAC — replaces the
// roles Json stopgap column on User. Admin permission groups (P2.10:
// admin_super/admin_finance/admin_ops/admin_support) are stored here too as
// `admin_*` rows; only users holding `admin` should have them.
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @db.VarChar(32)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, role])
  @@index([role])
  @@map("user_roles")
}

// One-time backup codes for TOTP login (P2.5). Only SHA-256 hashes stored,
// each code can be used exactly once.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique @db.VarChar(64)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("recovery_codes")
}

// One-time tokens for email verification and password reset.
// Token itself is random 32 bytes hex, only the SHA-256 hash is stored.
model VerificationToken {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  tokenHash String     @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([userId, type])
  @@map("verification_tokens")
}

// Login sessions. refreshHash holds the SHA-256 of the *current* refresh
// token; familyId groups a rotation chain so reuse of an old token revokes
// the whole chain (P2.4).
model Session {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId    String    @db.VarChar(64)
  refreshHash String    @unique @db.VarChar(64)
  // Role currently in use for this session (P2.9). Switching roles re-issues
  // the access token without a new login and is audit-logged.
  activeRole  String    @default("buyer") @db.VarChar(32)
  expiresAt   DateTime
  lastUsedAt  DateTime  @default(now())
  revokedAt   DateTime?
  ip          String?   @db.VarChar(64)
  userAgent   String?   @db.VarChar(512)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, familyId])
  @@index([userId, revokedAt])
  @@map("sessions")
}

// Email OTP codes for password-free login (P2.2, delivered via Gmail/SMTP —
// no SMS per the cost decision). Only the SHA-256 hash of the code is stored
// and the code never appears in logs.
model OtpRequest {
  id         String    @id @default(cuid())
  email      String    @db.VarChar(191)
  codeHash   String    @db.VarChar(64)
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  ip         String?   @db.VarChar(64)
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@map("otp_requests")
}