{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @cvc/shared build && prisma generate && nest build && tsc -p tsconfig.seed.json",
    "start": "node dist/main.js",
    "start:dev": "pnpm --filter @cvc/shared build && prisma generate && nest start --watch",
    "start:worker": "node dist/worker.js",
    "typecheck": "pnpm --filter @cvc/shared build && prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @cvc/shared build && prisma generate && jest",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:reset": "node scripts/prisma-reset.mjs",
    "openapi:export": "pnpm --filter @cvc/shared build && prisma generate && nest build && node dist/export-openapi.js"
  },
  "prisma": {
    "seed": "node dist/seed.js"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "isolatedModules": true
        }
      ],
      "^.+\\.js$": [
        "ts-jest",
        {
          "isolatedModules": true,
          "tsconfig": {
            "allowJs": true,
            "module": "commonjs",
            "esModuleInterop": true,
            "target": "es2021"
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!.*node_modules/(?:@nestjs/(?:websockets|platform-socket\\.io)))"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "forceExit": true
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@bull-board/api": "^9.13.1",
    "@bull-board/express": "^9.13.1",
    "@cvc/shared": "workspace:*",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^10.4.22",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.1",
    "nestjs-pino": "^4.1.0",
    "nodemailer": "^7.0.13",
    "otpauth": "^9.6.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^7.0.12",
    "@types/socket.io-client": "^3.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
