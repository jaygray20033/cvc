# CVC API environment. Copy to .env and fill in. Never commit .env.
# Values below are dev defaults matching infra/docker-compose.dev.yml.

# development | test | production
NODE_ENV=development
PORT=3000
# Public web origin (CORS) and public API origin (links, Swagger servers).
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# MySQL connection (Prisma). Host "mysql" is the dev compose service name.
DATABASE_URL=mysql://cvc:cvc@mysql:3306/cvc
# Redis connection (BullMQ, cache). Host "redis" is the dev compose service name.
REDIS_URL=redis://redis:6379

# Auth secrets: use long random strings. Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Encrypts sensitive fields at rest (CCCD, bank account). 32+ chars.
ENCRYPTION_KEY=dev-encryption-key-change-me-please-32

# S3 object storage (SeaweedFS S3 gateway). Dev uses the seaweedfs compose service.
S3_ENDPOINT=http://seaweedfs:9000
S3_REGION=us-east-1
S3_BUCKET_PUBLIC=cvc-public
S3_BUCKET_PRIVATE=cvc-private
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# SMTP. Dev uses mailpit (no auth). Production: real provider.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=CVC <no-reply@cvc.local>

# Integration keys: leave empty until a provider is wired (Backlog).
# D13: payments/eKYC/shipping are manual; no gateway or bank webhook here.
SMS_PROVIDER_KEY=
ZNS_PROVIDER_KEY=
TRANSLATION_PROVIDER_KEY=
INVOICE_PROVIDER_KEY=
EKYC_PROVIDER_KEY=